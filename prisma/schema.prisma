// This is your Prisma schema file

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  password      String
  avatar        String?
  bio           String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  favorites         Favorite[]
  courseFavorites   CourseFavorite[]
  readingHistory    ReadingHistory[]
  ratings           Rating[]
  courseRatings     CourseRating[]
  comments          Comment[]
  courseComments    CourseComment[]
  courses           UserCourse[]

  @@map("users")
}

model Book {
  id            String     @id @default(cuid())
  title         String
  author        String
  description   String?
  coverUrl      String?
  isbn          String?    @unique
  publishedDate DateTime?
  pageCount     Int?
  language      String?    @default("en")
  source        String
  sourceId      String
  downloadUrl   String?
  rating        Float      @default(0)
  reviewCount   Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  favorites     Favorite[]
  readingHistory ReadingHistory[]
  ratings       Rating[]
  comments      Comment[]

  @@unique([source, sourceId])
  @@index([title])
  @@index([author])
  @@map("books")
}

model Favorite {
  id      String   @id @default(cuid())
  userId  String
  bookId  String
  title   String   @default("")
  coverUrl String? 
  source  String   @default("")
  bookExtId String @default("")
  addedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("favorites")
}

model CourseFavorite {
  id        String   @id @default(cuid())
  userId    String
  courseExtId String
  title     String
  coverUrl  String?
  instructor String  @default("")
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course?  @relation(fields: [courseExtId], references: [id])

  @@unique([userId, courseExtId])
  @@index([userId])
  @@map("course_favorites")
}

model ReadingHistory {
  id           String   @id @default(cuid())
  userId       String
  bookId       String
  startDate    DateTime @default(now())
  lastReadDate DateTime @updatedAt
  currentPage  Int      @default(0)
  totalPages   Int?
  status       String   @default("reading")
  progress     Float    @default(0)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_history")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  score     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("ratings")
}

model CourseRating {
  id        String   @id @default(cuid())
  userId    String
  courseExtId String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseExtId])
  @@index([userId])
  @@map("course_ratings")
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([userId])
  @@index([bookId])
  @@index([parentId])
  @@map("comments")
}

model CourseComment {
  id          String          @id @default(cuid())
  userId      String
  courseExtId String
  content     String
  parentId    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      CourseComment?  @relation("CourseCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CourseComment[] @relation("CourseCommentReplies")

  @@index([userId])
  @@index([courseExtId])
  @@index([parentId])
  @@map("course_comments")
}

model Course {
  id          String         @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  instructor  String
  duration    Int?
  level       String         @default("beginner")
  rating      Float          @default(0)
  reviewCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users           UserCourse[]
  favorites       CourseFavorite[]

  @@index([title])
  @@map("courses")
}

model UserCourse {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Float     @default(0)
  status      String    @default("enrolled")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_courses")
}
