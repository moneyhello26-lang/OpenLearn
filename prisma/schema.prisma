datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  avatar        String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  favorites      Favorite[]
  courseFavorites CourseFavorite[]
  readingHistory ReadingHistory[]
  ratings        Rating[]
  courseRatings  CourseRating[]
  comments       Comment[]
  courseComments CourseComment[]
  courses        UserCourse[]
  reviewsWritten       UserReview[] @relation("ReviewAuthor")
  reviewsReceived      UserReview[] @relation("ReviewTarget")
  friendRequestsSent   Friendship[] @relation("FriendRequestSender")
  friendRequestsReceived Friendship[] @relation("FriendRequestReceiver")
  notifications        Notification[]
  communitiesCreated   Community[]
  communityMemberships CommunityMember[]
  communityMessages    CommunityMessage[]

  @@map("users")
}

model Book {
  id            String    @id @default(cuid())
  title         String
  author        String
  description   String?
  coverUrl      String?
  isbn          String?   @unique
  publishedDate DateTime?
  pageCount     Int?
  language      String?   @default("en")
  source        String
  sourceId      String
  downloadUrl   String?
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favorites      Favorite[]
  readingHistory ReadingHistory[]
  ratings        Rating[]
  comments       Comment[]

  @@unique([source, sourceId])
  @@index([title])
  @@index([author])
  @@map("books")
}

model Favorite {
  id      String   @id @default(cuid())
  userId  String
  bookId  String
  addedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("favorites")
}

model CourseFavorite {
  id          String   @id @default(cuid())
  userId      String
  courseExtId String
  title       String   @default("")
  coverUrl    String?
  instructor  String   @default("")
  addedAt     DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseExtId])
  @@index([userId])
  @@map("course_favorites")
}

model ReadingHistory {
  id           String   @id @default(cuid())
  userId       String
  bookId       String
  startDate    DateTime @default(now())
  lastReadDate DateTime @updatedAt
  currentPage  Int      @default(0)
  totalPages   Int?
  status       String   @default("reading")
  progress     Float    @default(0)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_history")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  score     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("ratings")
}

model CourseRating {
  id          String   @id @default(cuid())
  userId      String
  courseExtId String
  score       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseExtId])
  @@index([userId])
  @@map("course_ratings")
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  bookId    String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([userId])
  @@index([bookId])
  @@index([parentId])
  @@map("comments")
}

model CourseComment {
  id          String         @id @default(cuid())
  userId      String
  courseExtId String
  content     String
  parentId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      CourseComment? @relation("CourseCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CourseComment[] @relation("CourseCommentReplies")

  @@index([userId])
  @@index([courseExtId])
  @@index([parentId])
  @@map("course_comments")
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  instructor  String
  duration    Int?
  level       String       @default("beginner")
  rating      Float        @default(0)
  reviewCount Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       UserCourse[]

  @@index([title])
  @@map("courses")
}

model UserCourse {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  progress    Float     @default(0)
  status      String    @default("enrolled")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("user_courses")
}

model UserReview {
  id        String   @id @default(cuid())
  authorId  String
  targetId  String
  content   String
  createdAt DateTime @default(now())

  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@map("user_reviews")
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  status    String   @default("pending") // "pending", "accepted", "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("FriendRequestSender", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendRequestReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("friendships")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  content   String?
  sourceId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  creatorId   String
  createdAt   DateTime @default(now())

  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  messages    CommunityMessage[]

  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  role        String   @default("member") // "admin", "member"
  joinedAt    DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_members")
}

model CommunityMessage {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  content     String
  bookLink    String?
  createdAt   DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_messages")
}
